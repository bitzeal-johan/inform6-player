{
  "name": "inform6-player",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "vendor": "node scripts/vendor.mjs",
    "compile:advent": "dotnet run --project ../inform6-react/tools/CompileGame/CompileGame.csproj -- ../inform6-react/tests/compiler/Inform6Sharp.Compiler.Tests/RealGames/Advent.inf app/games/advent.ts --typescript ../inform6-react/tests/compiler/Inform6Sharp.Compiler.Tests/RealGames ../inform6-react/tests/compiler/Inform6Sharp.Compiler.Tests/RealGames/Inform6Lib",
    "compile:devours": "dotnet run --project ../inform6-react/tools/CompileGame/CompileGame.csproj -- ../inform6-react/tests/compiler/Inform6Sharp.Compiler.Tests/RealGames/Devours.inf app/games/devours.ts --typescript ../inform6-react/tests/compiler/Inform6Sharp.Compiler.Tests/RealGames ../inform6-react/tests/compiler/Inform6Sharp.Compiler.Tests/RealGames/Inform6Lib",
    "compile:game": "npm run vendor && npm run compile:advent && npm run compile:devours"
  },
  "dependencies": {
    "@inform6sharp/game-runner": "file:./packages/game-runner",
    "@inform6sharp/react-player": "file:./packages/react-player",
    "@inform6sharp/themes": "file:./packages/themes",
    "next": "16.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.0",
    "typescript": "^5"
  }
}
